# Database the service reads transactions from (SQLite file or PostgreSQL URL).
# SQLite:      sqlite:////app/db/database.sqlite
# PostgreSQL:  postgresql://spendly:spendly@postgres:5432/spendly
DATABASE_URL=sqlite:////app/db/database.sqlite

# Shared secret required on all non-health endpoints.
# Must match Laravel's ML_SERVICE_TOKEN. Empty = every protected endpoint returns 503.
ML_SERVICE_TOKEN=

# Root directory for model artifacts (models/) and personalization vectors (vectors/).
ML_DATA_DIR=/app/data

LOG_LEVEL=INFO
